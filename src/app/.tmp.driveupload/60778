<div class="inicio-empresa">
  <header class="cabecera-dialogo">
    <div class="cabecera-titulos">
      <h2>Iniciar atención empresarial</h2>
      <p>Programación <strong>{{ programacion?.codProgramacion || '-' }}</strong> · Verifica la identidad del trabajador antes de continuar</p>
    </div>
    <button mat-icon-button type="button" aria-label="Cerrar diálogo" (click)="cancelar()" [disabled]="procesandoInicio">
      <mat-icon>close</mat-icon>
    </button>
  </header>

  <form [formGroup]="iniciarAtencionProgramacionForm">
    <mat-dialog-content class="contenido-dialogo">
      <div class="contenedor-flex">
        <section class="contenedor-formulario">
          <mat-card class="tarjeta-info">
            <mat-card-title><mat-icon aria-hidden="true">person_outline</mat-icon>Datos del paciente</mat-card-title>
            <mat-card-content>
              <p class="alerta-identidad" *ngIf="!programacion?.nroDoc">
                <mat-icon aria-hidden="true">info_outline</mat-icon>
                Documento pendiente. Confirma los nombres y apellidos antes de iniciar.
              </p>
              <table class="tabla-detalles">
                <tbody>
                  <tr><th>Historia clínica</th><td>{{ programacion?.hc || 'Por asignar' }}</td></tr>
                  <tr><th>Tipo de documento</th><td>{{ programacion?.tipoDoc || 'Pendiente' }}</td></tr>
                  <tr><th>Número de documento</th><td>{{ programacion?.nroDoc || 'Pendiente' }}</td></tr>
                  <tr><th>Paciente</th><td class="nombre-paciente">{{ programacion?.apePatCliente }} {{ programacion?.apeMatCliente }} {{ programacion?.nombreCliente }}</td></tr>
                  <tr><th>Sexo</th><td>{{ programacion?.sexoCliente || '-' }}</td></tr>
                  <tr><th>Fecha nacimiento</th><td>{{ programacion?.fechaNacimiento ? (programacion?.fechaNacimiento | date: 'dd/MM/yyyy':'UTC') : '-' }}</td></tr>
                  <tr><th>Edad</th><td>{{ iniciarAtencionProgramacionForm.get('edad')?.value || '-' }}</td></tr>
                </tbody>
              </table>
            </mat-card-content>
          </mat-card>
        </section>

        <section class="contenedor-tablaCentro">
          <mat-card class="tarjeta-info tarjeta-foto">
            <mat-card-title><mat-icon aria-hidden="true">photo_camera</mat-icon>Fotografía del paciente</mat-card-title>
            <mat-card-content>
              <section class="captura-foto">
                <div class="marco-foto">
                  <video #cameraPreview *ngIf="cameraActiva" autoplay playsinline aria-label="Vista previa de la cámara"></video>
                  <img *ngIf="fotoPacienteUrl" [src]="fotoPacienteUrl" alt="Fotografía capturada del paciente" />
                  <div *ngIf="!cameraActiva && !fotoPacienteUrl" class="foto-vacia">
                    <mat-icon aria-hidden="true">account_circle</mat-icon>
                    <span>Fotografía opcional</span>
                  </div>
                </div>
                <div class="acciones-foto">
                  <button mat-stroked-button type="button" *ngIf="!cameraActiva && !fotoPaciente" (click)="activarCamara()" [disabled]="procesandoInicio">
                    <mat-icon>photo_camera</mat-icon> Activar cámara
                  </button>
                  <button mat-flat-button type="button" *ngIf="cameraActiva" (click)="capturarFoto()" [disabled]="procesandoInicio">
                    <mat-icon>camera</mat-icon> Capturar foto
                  </button>
                  <button mat-stroked-button type="button" *ngIf="fotoPaciente" (click)="repetirFoto()" [disabled]="procesandoInicio">
                    <mat-icon>refresh</mat-icon> Repetir foto
                  </button>
                </div>
              </section>
            </mat-card-content>
          </mat-card>
        </section>

        <section class="contenedor-tablaDerecha">
          <mat-card class="tarjeta-info">
            <mat-card-title><mat-icon aria-hidden="true">business</mat-icon>Programación de empresa</mat-card-title>
            <mat-card-content>
              <table class="tabla-detalles tabla-empresa">
                <tbody>
                  <tr><th>Cod. programación</th><td><strong class="codigo-programacion">{{ programacion?.codProgramacion || '-' }}</strong></td></tr>
                  <tr><th>Empresa</th><td>{{ programacion?.razonSocialEmpresa || '-' }}</td></tr>
                  <tr><th>RUC</th><td>{{ programacion?.rucEmpresa || '-' }}</td></tr>
                  <tr><th>Protocolo</th><td>{{ programacion?.nombreProtocolo || '-' }}</td></tr>
                </tbody>
              </table>

              <div class="servicios-titulo"><mat-icon aria-hidden="true">fact_check</mat-icon> Servicios programados</div>
              <table mat-table [dataSource]="programacion?.serviciosProgramados ?? []" class="tabla-servicios w-100">
                <ng-container matColumnDef="codigo">
                  <th mat-header-cell *matHeaderCellDef>Código</th>
                  <td mat-cell *matCellDef="let servicio">{{ servicio.codServicio }}</td>
                </ng-container>
                <ng-container matColumnDef="nombre">
                  <th mat-header-cell *matHeaderCellDef>Servicio</th>
                  <td mat-cell *matCellDef="let servicio">{{ servicio.nombreServicio }}</td>
                </ng-container>
                <tr mat-header-row *matHeaderRowDef="columnasServicios"></tr>
                <tr mat-row *matRowDef="let row; columns: columnasServicios"></tr>
              </table>
              <div class="sin-servicios" *ngIf="!programacion?.serviciosProgramados?.length">No hay servicios programados.</div>
            </mat-card-content>
          </mat-card>
        </section>
      </div>
    </mat-dialog-content>

    <mat-dialog-actions align="end" class="acciones-dialogo">
      <button mat-stroked-button type="button" (click)="cancelar()" [disabled]="procesandoInicio">Cancelar</button>
      <button mat-flat-button type="button" class="btn-iniciar" (click)="iniciarAtencion()" [disabled]="procesandoInicio">
        <mat-icon>play_arrow</mat-icon> {{ procesandoInicio ? 'Procesando...' : 'Iniciar atención' }}
      </button>
    </mat-dialog-actions>
  </form>
</div>
